{
  "services": {
    "app": {
      "root": ".",
      "entrypoint": "backend/index.js",
      "framework": "express",
      "buildCommand": "npm run build",
      "installCommand": "npm run install-all"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}